        "int": 12345
      },
      null
    ],
    "expect": [
      [
        {
          "bool": false
        }
      ],
      [
        {
          "int": 0
        }
      ]
    ]
  },
  {
    "name": "UDP: invalid host",
    "gh1": "UdpStreamComponent",
    "inputs": [
