[
 {
  "name": "TextBody: plain text uses the JSON default",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "text": "hello"
   }
  ],
  "expect": [
   [
    {
     "type": "RequestBodyText",
     "props": {
      "ContentType": {
       "text": "application/json"
      },
      "Text": {
       "text": "hello"
      },
      "Value": {
       "text": "hello"
      }
     }
    }
   ]
  ]
 },
 {
  "name": "TextBody: JSON object",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "jobject": "{\"a\":[1,2]}"
   }
  ],
  "expect": [
   [
    {
     "type": "RequestBodyText",
     "props": {
      "ContentType": {
       "text": "application/json"
      },
      "Text": {
       "text": "{\"a\":[1,2]}"
      },
      "Value": {
       "text": "{\"a\":[1,2]}"
      }
     }
    }
   ]
  ]
 },
 {
  "name": "TextBody: JSON array",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "jarray": "[1,\"x\"]"
   }
  ]
 },
 {
  "name": "TextBody: JSON null token",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "json": "null"
   }
  ]
 },
 {
  "name": "TextBody: XML",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "xml": "<a x=\"1\"><b/></a>"
   }
  ]
 },
 {
  "name": "TextBody: HTML",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "htmlel": "<p class=\"c\">hi</p>"
   }
  ]
 },
 {
  "name": "TextBody: no content",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   null
  ],
  "expect": [
   [
    {
     "type": "RequestBodyText",
     "props": {
      "ContentType": {
       "text": "application/json"
      },
      "Text": {
       "text": ""
      },
      "Value": {
       "text": ""
      }
     }
    }
   ]
  ]
 },
 {
  "name": "TextBody: unsupported content is an error",
  "gh1": "CreateTextBodyComponent",
  "inputs": [
   {
    "int": 5
   }
  ],
  "expectError": true
 },
 {
  "name": "TextBodyCustom: text + content type",
