[
 {
  "name": "CreateJsonArray: tokens",
  "gh1": "CreateJsonArrayComponent",
  "inputs": [
   [
    {
     "json": "1"
    },
    {
     "json": "\"a\""
    },
    {
     "json": "null"
    },
    {
     "json": "{\"k\":true}"
    }
   ]
  ],
  "expect": [
   [
    {
     "json": "[1,\"a\",null,{\"k\":true}]"
    }
   ]
  ]
 },
 {
  "name": "CreateJsonArray: single",
  "gh1": "CreateJsonArrayComponent",
  "inputs": [
   [
    {
     "json": "[]"
    }
   ]
  ],
  "expect": [
   [
    {
     "json": "[[]]"
    }
   ]
  ]
 },
 {
  "name": "CreateJsonObject: pairs",
  "gh1": "CreateJsonObjectComponent",
  "inputs": [
   [
    {
     "text": "a"
    },
    {
     "text": "b"
    }
   ],
   [
    {
     "json": "1"
    },
    {
     "json": "[2]"
    }
   ]
  ],
  "expect": [
   [
    {
     "json": "{\"a\":1,\"b\":[2]}"
    }
   ]
  ]
 },
 {
  "name": "CreateJsonObject: no inputs gives empty object",
  "gh1": "CreateJsonObjectComponent",
  "inputs": [
   null,
   null
  ],
  "expect": [
   [
    {
     "json": "{}"
    }
   ]
  ]
 },
 {
  "name": "CreateJsonObject: count mismatch is an error",
  "gh1": "CreateJsonObjectComponent",
  "inputs": [
   [
    {
     "text": "a"
    },
    {
     "text": "b"
    }
   ],
   [
    {
     "json": "1"
    }
   ]
  ],
  "expectError": true
 },
 {
  "name": "CreateJsonObject: duplicate key is an error",
  "gh1": "CreateJsonObjectComponent",
  "inputs": [
   [
    {
     "text": "a"
    },
    {
     "text": "a"
    }
   ],
   [
    {
     "json": "1"
    },
    {
     "json": "2"
    }
   ]
  ],
  "expectError": true
 },
