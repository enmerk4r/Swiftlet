 {
  "name": "Merge: default B wins, recursive",
  "gh1": "MergeJsonObjectsComponent",
  "inputs": [
   {
    "jobject": "{\"a\":1,\"n\":{\"x\":1,\"y\":1}}"
   },
   {
    "jobject": "{\"a\":2,\"n\":{\"y\":2}}"
   },
   null
  ],
  "expect": [
   [
    {
     "json": "{\"a\":2,\"n\":{\"x\":1,\"y\":2}}"
    }
   ]
  ]
 },
 {
  "name": "Merge: mode 0 A wins",
  "gh1": "MergeJsonObjectsComponent",
  "inputs": [
   {
    "jobject": "{\"a\":1}"
   },
   {
    "jobject": "{\"a\":2,\"b\":3}"
   },
   {
    "int": 0
   }
  ]
 },
 {
  "name": "Merge: mode 2 A unless null",
  "gh1": "MergeJsonObjectsComponent",
  "inputs": [
   {
    "jobject": "{\"a\":null,\"b\":1}"
   },
   {
    "jobject": "{\"a\":2,\"b\":3}"
   },
   {
    "int": 2
   }
  ]
 },
 {
  "name": "Merge: mode 3 B unless null",
  "gh1": "MergeJsonObjectsComponent",
  "inputs": [
   {
    "jobject": "{\"a\":1,\"b\":1}"
   },
   {
    "jobject": "{\"a\":null,\"b\":3}"
   },
   {
    "int": 3
   }
  ]
 },
 {
  "name": "Merge: invalid mode warns and uses B",
  "gh1": "MergeJsonObjectsComponent",
  "inputs": [
   {
    "jobject": "{\"a\":1}"
   },
   {
    "jobject": "{\"a\":2}"
   },
   {
    "int": 9
   }
  ],
  "expect": [
   [
    {
     "json": "{\"a\":2}"
    }
   ]
  ]
 },
