  {
    "name": "MCP tool empty optional list",
    "gh1": "DefineToolComponent",
    "inputs": [
      {
        "text": "hello"
      },
      {
        "text": "say hello"
      }
    ],
    "expect": [
      [
        {
          "mcp": {
            "name": "hello",
            "description": "say hello",
            "inputSchema": {
              "type": "object",
              "properties": {}
            }
          }
        }
      ]
    ]
  },
  {
    "name": "MCP tool schema required and optional",
    "gh1": "DefineToolComponent",
    "inputs": [
      {
        "text": "count"
      },
      {
        "text": "counts"
      },
      [
        {
          "mcpparam": {
            "name": "n",
            "type": "int",
            "required": true
          }
        },
        {
          "mcpparam": {
            "name": "label",
            "required": false
          }
        }
      ]
    ],
    "expect": [
      [
        {
          "mcp": {
            "name": "count",
            "description": "counts",
            "inputSchema": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "n"
              ]
            }
          }
        }
      ]
    ]
  },
