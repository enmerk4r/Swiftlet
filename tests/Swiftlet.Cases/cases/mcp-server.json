  {
    "name": "MCP resource link minimal",
    "gh1": "CreateMcpResourceLinkComponent",
    "inputs": [
      {
        "text": "file:///a.txt"
      },
      {
        "text": "a"
      }
    ],
    "expect": [
      [
        {
          "mcp": {
            "type": "resource_link",
            "uri": "file:///a.txt",
            "name": "a"
          }
        }
      ]
    ]
  },
  {
    "name": "MCP resource link metadata",
    "gh1": "CreateMcpResourceLinkComponent",
    "inputs": [
      {
        "text": "https://example.com/a"
      },
      {
        "text": "a"
      },
      {
        "text": "Title"
      },
      {
        "text": "Description"
      },
      {
        "text": "text/plain"
      }
    ],
    "expect": [
      [
        {
          "mcp": {
            "type": "resource_link",
            "uri": "https://example.com/a",
            "name": "a",
            "title": "Title",
            "description": "Description",
            "mimeType": "text/plain"
          }
        }
      ]
    ]
  },
