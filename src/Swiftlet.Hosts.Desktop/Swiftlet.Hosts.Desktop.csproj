<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Version.props" />
  <PropertyGroup>
    <!-- Shared libraries carry the Swiftlet version so a stale copy from another install cannot be mistaken for this one. -->
    <Version>$(SwiftletVersion)</Version>
    <AssemblyVersion>$(SwiftletAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SwiftletAssemblyVersion)</FileVersion>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Swiftlet.Hosts.Desktop</RootNamespace>
    <AssemblyName>Swiftlet.Hosts.Desktop</AssemblyName>
    <Description>Interactive desktop host services for Swiftlet.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swiftlet.HostAbstractions\Swiftlet.HostAbstractions.csproj" />
  </ItemGroup>
</Project>
