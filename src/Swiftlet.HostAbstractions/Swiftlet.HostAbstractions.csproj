<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Version.props" />
  <PropertyGroup>
    <!-- Shared libraries carry the Swiftlet version so a stale copy from another install cannot be mistaken for this one. -->
    <Version>$(SwiftletVersion)</Version>
    <AssemblyVersion>$(SwiftletAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SwiftletAssemblyVersion)</FileVersion>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Swiftlet.HostAbstractions</RootNamespace>
    <AssemblyName>Swiftlet.HostAbstractions</AssemblyName>
    <Description>Host capability and platform service abstractions for Swiftlet.</Description>
  </PropertyGroup>
</Project>
