<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <LangVersion>12.0</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RootNamespace>Swiftlet.Hosts.Rhino</RootNamespace>
    <AssemblyName>Swiftlet.Hosts.Rhino</AssemblyName>
    <Description>Rhino host services (notifications, clipboard, browser, viewport capture) shared by the Grasshopper 1 and Grasshopper 2 shells. References RhinoCommon only, never Grasshopper.</Description>
    <RhinoCommonPackageVersion>8.0.23304.9001</RhinoCommonPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Swiftlet.Gh.Rhino8" />
    <InternalsVisibleTo Include="Swiftlet.Gh2" />
    <InternalsVisibleTo Include="Swiftlet.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only: Rhino supplies RhinoCommon and System.Drawing.Common at runtime. -->
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swiftlet.Imaging\Swiftlet.Imaging.csproj" />
    <ProjectReference Include="..\Swiftlet.HostAbstractions\Swiftlet.HostAbstractions.csproj" />
    <ProjectReference Include="..\Swiftlet.Hosts.Desktop\Swiftlet.Hosts.Desktop.csproj" />
    <ProjectReference Include="..\Swiftlet.Hosts.Headless\Swiftlet.Hosts.Headless.csproj" />
  </ItemGroup>
</Project>
