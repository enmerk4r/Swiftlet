<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <Import Project="..\..\build\Version.props" />
  <PropertyGroup>
    <!-- Shared libraries carry the Swiftlet version so a stale copy from another install cannot be mistaken for this one. -->
    <Version>$(SwiftletVersion)</Version>
    <AssemblyVersion>$(SwiftletAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SwiftletAssemblyVersion)</FileVersion>
    <PublishAot>false</PublishAot>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Swiftlet.Core</RootNamespace>
    <AssemblyName>Swiftlet.Core</AssemblyName>
    <Description>Shared Swiftlet domain logic for all Rhino hosts.</Description>
  </PropertyGroup>
</Project>
